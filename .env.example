# === DATABASE ===
DATABASE_URL=postgresql://chaos:chaos@localhost:5432/chaosdb
POSTGRES_USER=chaos
POSTGRES_PASSWORD=chaos
POSTGRES_DB=chaosdb

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === BACKEND ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# === FRONTEND ===
VITE_API_BASE_URL=http://localhost:8000

# === BROWSER AUTOMATION ===
# Set to 'true' to run browser in headless mode (default for Docker)
HEADLESS=true
# Maximum seconds to wait for page load
PAGE_TIMEOUT_MS=30000
# Maximum actions per test run (safety limit)
MAX_ACTIONS_PER_RUN=200
# Maximum crawl depth
MAX_CRAWL_DEPTH=3

# === SAFETY ===
# Comma-separated allowed domains (empty = use project URL domain only)
ALLOWED_DOMAINS=
# Safe mode prevents destructive operations
SAFE_MODE=true

# === AI PROVIDER (Phase 0+1: not used) ===
AI_PROVIDER=rules
# AI_PROVIDER=llm
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
